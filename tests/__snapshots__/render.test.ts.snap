exports[`snapshots architecture in the light theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="graph" version="1.1" viewBox="0 0 346 1081" width="346" height="1081" font-family="Inter, system-ui, sans-serif">
<title>Settings page flow</title>
<defs><style>.sg-root{--sg-bg:#ffffff;--sg-fg:#1f2430;--sg-muted:#6b7280;--sg-node-fill:#ffffff;--sg-node-stroke:#475569;--sg-unknown-fill:#f1f5f9;--sg-group-fill:#f1f5f9;--sg-group-stroke:#cbd5e1;--sg-edge:#475569;--sg-label-bg:#ffffff;--sg-accent:#2563eb;--sg-lifeline:#94a3b8;--sg-header-fill:#e2e8f0}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}.sg-root [data-type="page"] .sg-node{fill:#dbeafe;stroke:#2563eb}.sg-root [data-type="page"] .sg-label{fill:#1e3a8a}.sg-root [data-type="component"] .sg-node{fill:#ffedd5;stroke:#ea580c}.sg-root [data-type="component"] .sg-label{fill:#7c2d12}.sg-root [data-type="hook"] .sg-node{fill:#ede9fe;stroke:#7c3aed}.sg-root [data-type="hook"] .sg-label{fill:#4c1d95}.sg-root [data-type="endpoint"] .sg-node{fill:#fce7f3;stroke:#db2777}.sg-root [data-type="endpoint"] .sg-label{fill:#831843}.sg-root [data-type="handler"] .sg-node{fill:#ecfccb;stroke:#65a30d}.sg-root [data-type="handler"] .sg-label{fill:#365314}.sg-root [data-type="service"] .sg-node{fill:#cffafe;stroke:#0891b2}.sg-root [data-type="service"] .sg-label{fill:#164e63}.sg-root [data-type="repository"] .sg-node{fill:#dcfce7;stroke:#16a34a}.sg-root [data-type="repository"] .sg-label{fill:#14532d}.sg-root [data-type="database"] .sg-node{fill:#fef3c7;stroke:#d97706}.sg-root [data-type="database"] .sg-label{fill:#78350f}.sg-root [data-confidence="unknown"] .sg-node{fill:var(--sg