g-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="151.5" y="956" width="79" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="191" y="969.87" text-anchor="middle" font-size="12" fill="#1f2430">reads/writes</text></g><g data-kind="node" data-id="GeneralSettings" data-type="page" data-shape="box"><rect class="sg-node" x="51.67" y="51" width="133" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="118.17" y="76.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">GeneralSettings</text><text class="sg-muted sg-caption" x="118.17" y="90.75" text-anchor="middle" font-size="11" fill="#6b7280">page</text></g><g data-kind="node" data-id="ThemeSelector" data-type="component" data-shape="box"><rect class="sg-node" x="32" y="164" width="128" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="96" y="189.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">ThemeSelector</text><text class="sg-muted sg-caption" x="96" y="203.75" text-anchor="middle" font-size="11" fill="#6b7280">component</text></g><g data-kind="node" data-id="useSettings" data-type="hook" data-shape="box"><rect class="sg-node" x="180" y="164" width="105" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="189.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">useSettings</text><text class="sg-muted sg-caption" x="232.5" y="203.75" text-anchor="middle" font-size="11" fill="#6b7280">hook</text></g><g data-kind="node" data-id="PatchSettings" data-type="endpoint" data-shape="box"><rect class="sg-node" x="151" y="410" width="163" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="435.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">PATCH /api/settings</text><text class="sg-muted sg-caption" x="232.5" y="449.75" text-anchor="middle" font-size="11" fill="#6b7280">endpoint</text></g><g data-kind="node" data-id="SettingsController" data-type="handler" data-shape="box"><rect class="sg-node" x="158" y="523" width="149" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="548.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">settings.controller</text><text class="sg-muted sg-caption" x="232.5" y="562.75" text-anchor="middle" font-size="11" fill="#6b7280">handler</text></g><g data-kind="node" data-id="SettingsService" data-type="service" data-shape="box"><rect class="sg-node" x="166.5" y="636" width="132" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="661.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">SettingsService</text><text class="sg-muted sg-caption" x="232.5" y="675.75" text-anchor="middle" font-size="11" fill="#6b7280">service</text></g><g data-kind="node" data-id="SettingsRepository" data-type="repository" data-shape="box"><rect class="sg-node" x="155.5" y="882" width="154" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="907.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">SettingsRepository</text><text class="sg-muted sg-caption" x="232.5" y="921.75" text-anchor="middle" font-size="11" fill="#6b7280">repository</text></g><g data-kind="node" data-id="SettingsTable" data-type="database" data-shape="box"><rect class="sg-node" x="174.5" y="995" width="116" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="1020.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">settings table</text><text class="sg-muted sg-caption" x="232.5" y="1034.75" text-anchor="middle" font-size="11" fill="#6b7280">database</text></g>
</svg>
