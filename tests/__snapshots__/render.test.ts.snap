<rect class="sg-bg" x="0" y="0" width="346" height="1081" fill="#ffffff"/>
<g data-kind="group" data-id="frontend" data-depth="0"><rect class="sg-group" x="20" y="20" width="277" height="210" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/><text class="sg-muted sg-label" x="32" y="39.87" text-anchor="start" font-size="12" font-weight="600" fill="#6b7280">Frontend</text></g><g data-kind="group" data-id="backend" data-depth="0"><rect class="sg-group" x="139" y="379" width="187" height="323" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/><text class="sg-muted sg-label" x="151" y="398.87" text-anchor="start" font-size="12" font-weight="600" fill="#6b7280">Backend</text></g><g data-kind="group" data-id="storage" data-depth="0"><rect class="sg-group" x="139.5" y="851" width="182" height="210" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/><text class="sg-muted sg-label" x="151.5" y="870.87" text-anchor="start" font-size="12" font-weight="600" fill="#6b7280">Storage</text></g><g data-kind="edge" data-id="e0" data-from="GeneralSettings" data-to="ThemeSelector"><path class="sg-edge" d="M96,105 L96,164" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="42" y="125" width="52" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="68" y="138.87" text-anchor="middle" font-size="12" fill="#1f2430">renders</text></g><g data-kind="edge" data-id="e1" data-from="GeneralSettings" data-to="useSettings"><path class="sg-edge" d="M140.33,105 L140.33,115 L232.5,115 L232.5,164" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="235.5" y="125" width="35" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="253" y="138.87" text-anchor="middle" font-size="12" fill="#1f2430">uses</text></g><g data-kind="edge" data-id="e2" data-from="useSettings" data-to="PatchSettings"><path class="sg-edge" d="M232.5,218 L232.5,410" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="196.5" y="295" width="34" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="213.5" y="308.87" text-anchor="middle" font-size="12" fill="#1f2430">calls</text></g><g data-kind="edge" data-id="e3" data-from="PatchSettings" data-to="SettingsController"><path class="sg-edge" d="M232.5,464 L232.5,523" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="177.5" y="484" width="53" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="204" y="497.87" text-anchor="middle" font-size="12" fill="#1f2430">handles</text></g><g data-kind="edge" data-id="e4" data-from="SettingsController" data-to="SettingsService"><path class="sg-edge" d="M232.5,577 L232.5,636" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="166.5" y="597" width="64" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="198.5" y="610.87" text-anchor="middle" font-size="12" fill="#1f2430">delegates</text></g><g data-kind="edge" data-id="e5" data-from="SettingsService" data-to="SettingsRepository"><path class="sg-edge" d="M232.5,690 L232.5,882" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="195.5" y="767" width="35" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="213" y="780.87" text-anchor="middle" font-size="12" fill="#1f2430">uses</text></g><g data-kind="edge" data-id="e6" data-from="SettingsRepository" data-to="SettingsTable"><path class="sg-edge" d="M232.5,936 L232.5,995" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="151.5" y="956" width="79" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="191" y="969.87" text-anchor="middle" font-size="12" fill="#1f2430">reads/writes</text></g><g data-kind="node" data-id="GeneralSettings" data-type="page" data-shape="box"><rect class="sg-node" x="51.67" y="51" width="133" height="54" rx="8" fill="#dbeafe" stroke="#2563eb" stroke-width="1.5"/><text class="sg-text sg-label" x="118.17" y="76.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1e3a8a">GeneralSettings</text><text class="sg-muted sg-caption" x="118.17" y="90.75" text-anchor="middle" font-size="11" fill="#6b7280">page</text></g><g data-kind="node" data-id="ThemeSelector" data-type="component" data-shape="box"><rect class="sg-node" x="32" y="164" width="128" height="54" rx="8" fill="#ffedd5" stroke="#ea580c" stroke-width="1.5"/><text class="sg-text sg-label" x="96" y="189.22" text-anchor="middle" font-size="14" font-weight="600" fill="#7c2d12">ThemeSelector</text><text class="sg-muted sg-caption" x="96" y="203.75" text-anchor="middle" font-size="11" fill="#6b7280">component</text></g><g data-kind="node" data-id="useSettings" data-type="hook" data-shape="box"><rect class="sg-node" x="180" y="164" width="105" height="54" rx="8" fill="#ede9fe" stroke="#7c3aed" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="189.22" text-anchor="middle" font-size="14" font-weight="600" fill="#4c1d95">useSettings</text><text class="sg-muted sg-caption" x="232.5" y="203.75" text-anchor="middle" font-size="11" fill="#6b7280">hook</text></g><g data-kind="node" data-id="PatchSettings" data-type="endpoint" data-shape="box"><rect class="sg-node" x="151" y="410" width="163" height="54" rx="8" fill="#fce7f3" stroke="#db2777" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="435.22" text-anchor="middle" font-size="14" font-weight="600" fill="#831843">PATCH /api/settings</text><text class="sg-muted sg-caption" x="232.5" y="449.75" text-anchor="middle" font-size="11" fill="#6b7280">endpoint</text></g><g data-kind="node" data-id="SettingsController" data-type="handler" data-shape="box"><rect class="sg-node" x="158" y="523" width="149" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="548.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">settings.controller</text><text class="sg-muted sg-caption" x="232.5" y="562.75" text-anchor="middle" font-size="11" fill="#6b7280">handler</text></g><g data-kind="node" data-id="SettingsService" data-type="service" data-shape="box"><rect class="sg-node" x="166.5" y="636" width="132" height="54" rx="8" fill="#cffafe" stroke="#0891b2" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="661.22" text-anchor="middle" font-size="14" font-weight="600" fill="#164e63">SettingsService</text><text class="sg-muted sg-caption" x="232.5" y="675.75" text-anchor="middle" font-size="11" fill="#6b7280">service</text></g><g data-kind="node" data-id="SettingsRepository" data-type="repository" data-shape="box"><rect class="sg-node" x="155.5" y="882" width="154" height="54" rx="8" fill="#dcfce7" stroke="#16a34a" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="907.22" text-anchor="middle" font-size="14" font-weight="600" fill="#14532d">SettingsRepository</text><text class="sg-muted sg-caption" x="232.5" y="921.75" text-anchor="middle" font-size="11" fill="#6b7280">repository</text></g><g data-kind="node" data-id="SettingsTable" data-type="database" data-shape="box"><rect class="sg-node" x="174.5" y="995" width="116" height="54" rx="8" fill="#fef3c7" stroke="#d97706" stroke-width="1.5"/><text class="sg-text sg-label" x="232.5" y="1020.22" text-anchor="middle" font-size="14" font-weight="600" fill="#78350f">settings table</text><text class="sg-muted sg-caption" x="232.5" y="1034.75" text-anchor="middle" font-size="11" fill="#6b7280">database</text></g>
</svg>
"
