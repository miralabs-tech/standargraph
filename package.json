{
  "name": "@miralabs-tech/standargraph",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Declarative graph and diagram rendering",
  "keywords": [
    "graph",
    "diagram",
    "svg",
    "webgl",
    "elk",
    "sequence-diagram",
    "visualization",
    "cli",
    "remark"
  ],
  "homepage": "https://github.com/miralabs-tech/standargraph#readme",
  "bugs": {
    "url": "https://github.com/miralabs-tech/standargraph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miralabs-tech/standargraph.git"
  },
  "bin": {
    "standargraph": "dist/cli.js"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl/index.d.ts",
      "import": "./dist/webgl/index.js"
    },
    "./remark": {
      "types": "./dist/remark/index.d.ts",
      "import": "./dist/remark/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid/index.d.ts",
      "import": "./dist/mermaid/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./schema/graph-document.v1.json": "./schema/graph-document.v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "assets",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun scripts/clean.ts && bun build src/cli.ts src/core/index.ts src/format/index.ts src/layout/index.ts src/svg/index.ts src/webgl/index.ts src/remark/index.ts src/html/index.ts src/export/index.ts src/text/index.ts src/mermaid/index.ts --root src --outdir dist --splitting --target node --format esm --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "schema": "bun scripts/schema.ts",
    "metrics": "bun scripts/font-metrics.ts",
    "runtime": "bun scripts/build-runtime.ts",
    "generate": "bun scripts/generate.ts",
    "bench": "bun bench/run.ts",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "smoke": "bun tools/smoke.ts",
    "test:browser": "bun test --config=bunfig.browser.toml tests/browser"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/pdfkit": "^0.17.7",
    "opentype.js": "^2.0.0",
    "playwright-core": "^1.65.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@sinclair/typebox": "^0.34.52",
    "elkjs": "^0.12.1",
    "graphology": "^0.26.0",
    "pdfkit": "^0.20.2",
    "sigma": "^4.0.6",
    "svg-to-pdfkit": "^0.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
