<defs><style>.sg-root{--sg-bg:#ffffff;--sg-fg:#1f2430;--sg-muted:#6b7280;--sg-node-fill:#ffffff;--sg-node-stroke:#475569;--sg-unknown-fill:#f1f5f9;--sg-group-fill:#f1f5f9;--sg-group-stroke:#cbd5e1;--sg-edge:#475569;--sg-label-bg:#ffffff;--sg-accent:#2563eb;--sg-lifeline:#94a3b8;--sg-header-fill:#e2e8f0}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}</style><marker id="sg-arrow-filled" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-filled" d="M0,0 L10,5 L0,10 z" fill="#475569" stroke="#475569" stroke-width="1" stroke-linejoin="round"/></marker><marker id="sg-arrow-open" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-open" d="M1,1 L9,5 L1,9" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<rect class="sg-bg" x="0" y="0" width="346" height="1081" fill="#ffffff"/>
<g data-kind="group" data-id="frontend" data-depth="0"><rect class="sg-group" x="20" y="20" width="277" height="210" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/><text class="sg-muted sg-label" x="32" y="39.87" text-anchor="start" font-size="12" font-weight="600" fill="#6b7280">Frontend</text></g><g data-kind="group" data-id="backend" data-depth="0"><rect class="sg-group" x="139" y="379" width="187" height="323" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/><text class="sg-muted sg-label" x="151" y="398.87" text-anchor="start" font-size="12" font-weight="600" fill="#6b7280">Backend</text></g><g data-kind="group" data-id="storage" data-depth="0"><rect class="sg-group" x="139.5" y="851" width="182" height="210" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/><text class="sg-muted sg-label" x="151.5" y="870.87" text-anchor="start" font-size="12" font-weight="600" fill="#6b7280">Storage</text></g><g data-kind="edge" data-id="e0" data-from="GeneralSettings" data-to="ThemeSelector"><path class="sg-edge" d="M96,105 L96,164" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="42" y="125" width="52" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="68" y="138.87" text-anchor="middle" font-size="12" fill="#1f2430">renders</text></g><g data-kind="edge" data-id="e1" data-from="GeneralSettings" data-to="useSettings"><path class="sg-edge" d="M140.33,105 L140.33,115 L232.5,115 L232.5,164" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><rect class="sg-label-bg sg-edge-label" x="235.5" y="125" width="35" height="19" rx="3" fill="#ffffff"/><text class="sg-text sg-edge-label" x="253" y="138.87" text-anchor="middle" font-size="12" fill="#1f2430">uses</text></g><g data-kind="edge" data-id="e2" data-from="useSettings" data-to="PatchSettings"><path class="sg-edge" d="M232.5