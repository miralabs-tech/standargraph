exports[`snapshots architecture in the light theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="graph" version="1.1" viewBox="0 0 346 1081" width="346" height="1081" font-family="Inter, system-ui, sans-serif">
