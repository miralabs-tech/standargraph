exports[`snapshots repo-tree in the light theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="tree" data-layout="tree" version="1.1" viewBox="0 0 760.5 304" width="760.5" height="304" font-family="Inter, system-ui, sans-serif">
<title>Repository layout</title>
<defs><style>.sg-root{--sg-bg:#ffffff;--sg-fg:#1f2430;--sg-muted:#6b7280;--sg-node-fill:#ffffff;--sg-node-stroke:#475569;--sg-unknown-fill:#f1f5f9;--sg-group-fill:#f1f5f9;--sg-group-stroke:#cbd5e1;--sg-edge:#475569;--sg-label-bg:#ffffff;--sg-accent:#2563eb;--sg-lifeline:#94a3b8;--sg-header-fill:#e2e8f0}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}.sg-root [data-type="folder"] .sg-node{fill:#ecfccb;stroke:#65a30d}.sg-root [data-type="folder"] .sg-label{fill:#365314}.sg-root [data-type="file"] .sg-node{fill:#ffe4e6;stroke:#e11d48}.sg-root [data-type="file"] .sg-label{fill:#881337}.sg-root [data-confidence="unknown"] .sg-node{fill:var(--sg-unknown-fill)}</style><marker id="sg-arrow-filled" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-filled" d="M0,0 L10,5 L0,10 z" fill="#475569" stroke="#475569" stroke-width="1" stroke-linejoin="round"/></marker><marker id="sg-arrow-open" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-open" d="M1,1 L9,5 L1,9" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<rect class="sg-bg" x="0" y="0" width="760.5" height="304" fill="#ffffff"/>
<g data-kind="edge" data-id="src" data-from="repo" data-to="src"><path class="sg-edge" d="M447.75,74 L447.75,98 L210,98 L210,125" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="format" data-from="src" data-to="format"><path class="sg-edge" d="M210,179 L210,206 L60,206 L60,230" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="layout" data-from="src" data-to="layout"><path class="sg-edge" d="M210,179 L210,206 L160,206 L160,230" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="svg" data-from="src" data-to="svg"><path class="sg-edge" d="M210,179 L210,206 L260,206 L260,230" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="html" data-from="src" data-to="html"><path class="sg-edge" d="M210,179 L210,206 L360,206 L360,230" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="tests" data-from="repo" data-to="tests"><path class="sg-edge" d="M447.75,74 L447.75,98 L460.5,98 L460.5,125" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="browser" data-from="tests" data-to="browser"><path class="sg-edge" d="M460.5,179 L460.5,230" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="examples" data-from="repo" data-to="examples"><path class="sg-edge" d="M447.75,74 L447.75,98 L565.5,98 L565.5,125" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="readme" data-from="repo" data-to="readme"><path class="sg-edge" d="M447.75,74 L447.75,98 L685.5,98 L685.5,122" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="node" data-id="repo" data-type="folder" data-shape="pill" data-depth="0"><rect class="sg-node" x="376.25" y="20" width="143" height="54" rx="27" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="447.75" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">standargraph</text><text class="sg-muted sg-caption" x="447.75" y="59.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="src" data-type="folder" data-shape="box" data-depth="1"><rect class="sg-node" x="170" y="125" width="80" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="210" y="150.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">src</text><text class="sg-muted sg-caption" x="210" y="164.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="format" data-type="folder" data-shape="box" data-depth="2"><title>Schema and semantic checks</title><rect class="sg-node" x="20" y="230" width="80" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="60" y="255.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">format</text><text class="sg-muted sg-caption" x="60" y="269.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="layout" data-type="folder" data-shape="box" data-depth="2"><rect class="sg-node" x="120" y="230" width="80" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="160" y="255.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">layout</text><text class="sg-muted sg-caption" x="160" y="269.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="svg" data-type="folder" data-shape="box" data-depth="2"><rect class="sg-node" x="220" y="230" width="80" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="260" y="255.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">svg</text><text class="sg-muted sg-caption" x="260" y="269.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="html" data-type="folder" data-shape="box" data-depth="2"><rect class="sg-node" x="320" y="230" width="80" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="360" y="255.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">html</text><text class="sg-muted sg-caption" x="360" y="269.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="tests" data-type="folder" data-shape="box" data-depth="1"><rect class="sg-node" x="420.5" y="125" width="80" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="460.5" y="150.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">tests</text><text class="sg-muted sg-caption" x="460.5" y="164.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="browser" data-type="folder" data-shape="box" data-depth="2"><rect class="sg-node" x="420" y="230" width="81" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="460.5" y="255.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">browser</text><text class="sg-muted sg-caption" x="460.5" y="269.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="examples" data-type="folder" data-shape="box" data-depth="1"><rect class="sg-node" x="520.5" y="125" width="90" height="54" rx="8" fill="#ecfccb" stroke="#65a30d" stroke-width="1.5"/><text class="sg-text sg-label" x="565.5" y="150.22" text-anchor="middle" font-size="14" font-weight="600" fill="#365314">examples</text><text class="sg-muted sg-caption" x="565.5" y="164.75" text-anchor="middle" font-size="11" fill="#6b7280">folder</text></g><g data-kind="node" data-id="readme" data-type="file" data-shape="document" data-depth="1"><path class="sg-node" d="M630.5,122 H740.5 V176 C713,164 658,188 630.5,176 Z" fill="#ffe4e6" stroke="#e11d48" stroke-width="1.5"/><text class="sg-text sg-label" x="685.5" y="147.22" text-anchor="middle" font-size="14" font-weight="600" fill="#881337">README.md</text><text class="sg-muted sg-caption" x="685.5" y="161.75" text-anchor="middle" font-size="11" fill="#6b7280">file</text></g>
</svg>
"
`;

exports[`snapshots protocol in the dark theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="sequence" version="1.1" viewBox="0 0 878.5 542" width="878.5" height="542" font-family="Inter, system-ui, sans-serif">
<title>OAuth 2.0 authorization code flow with PKCE</title>
<defs><style>.sg-root{--sg-bg:#0f172a;--sg-fg:#e2e8f0;--sg-muted:#94a3b8;--sg-node-fill:#1e293b;--sg-node-stroke:#94a3b8;--sg-unknown-fill:#111827;--sg-group-fill:#162033;--sg-group-stroke:#334155;--sg-edge:#94a3b8;--sg-label-bg:#0f172a;--sg-accent:#60a5fa;--sg-lifeline:#475569;--sg-header-fill:#273449}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}.sg-root [data-type="client"] .sg-node{fill:#1e3a8a;stroke:#60a5fa}.sg-root [data-type="client"] .sg-label{fill:#dbeafe}.sg-root [data-type="service"] .sg-node{fill:#7c2d12;stroke:#fb923c}.sg-root [data-type="service"] .sg-label{fill:#ffedd5}.sg-root [data-confidence="unknown"] .sg-node{fill:var(--sg-unknown-fill)}</style><marker id="sg-arrow-filled" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-filled" d="M0,0 L10,5 L0,10 z" fill="#94a3b8" stroke="#94a3b8" stroke-width="1" stroke-linejoin="round"/></marker><marker id="sg-arrow-open" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-open" d="M1,1 L9,5 L1,9" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<rect class="sg-bg" x="0" y="0" width="878.5" height="542" fill="#0f172a"/>
<g data-kind="participant" data-id="browser" data-type="client"><line class="sg-lifeline" x1="70" y1="74" x2="70" y2="522" stroke="#475569" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="20" y="20" width="100" height="54" rx="8" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5"/><text class="sg-text sg-label" x="70" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#dbeafe">Browser</text><text class="sg-muted sg-caption" x="70" y="59.75" text-anchor="middle" font-size="11" fill="#94a3b8">client</text></g><g data-kind="participant" data-id="app" data-type="client"><line class="sg-lifeline" x1="336" y1="74" x2="336" y2="522" stroke="#475569" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="286" y="20" width="100" height="54" rx="8" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5"/><text class="sg-text sg-label" x="336" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#dbeafe">App</text><text class="sg-muted sg-caption" x="336" y="59.75" text-anchor="middle" font-size="11" fill="#94a3b8">client</text></g><g data-kind="participant" data-id="auth" data-type="service"><line class="sg-lifeline" x1="637" y1="74" x2="637" y2="522" stroke="#475569" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="555.5" y="20" width="163" height="54" rx="8" fill="#7c2d12" stroke="#fb923c" stroke-width="1.5"/><text class="sg-text sg-label" x="637" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#ffedd5">Authorization server</text><text class="sg-muted sg-caption" x="637" y="59.75" text-anchor="middle" font-size="11" fill="#94a3b8">service</text></g><g data-kind="participant" data-id="api" data-type="service"><line class="sg-lifeline" x1="808.5" y1="74" x2="808.5" y2="522" stroke="#475569" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="758.5" y="20" width="100" height="54" rx="8" fill="#7c2d12" stroke="#fb923c" stroke-width="1.5"/><text class="sg-text sg-label" x="808.5" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#ffedd5">API</text><text class="sg-muted sg-caption" x="808.5" y="59.75" text-anchor="middle" font-size="11" fill="#94a3b8">service</text></g><g data-kind="message" data-id="0" data-from="browser" data-to="app" data-style="sync"><path class="sg-edge" d="M70,142 L336,142" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="203" y="133.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Click sign in</text></g><g data-kind="message" data-id="1" data-from="app" data-to="app" data-style="sync"><path class="sg-edge" d="M336,160 H366 V180 H336" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="499.5" y="174.37" text-anchor="middle" font-size="12" fill="#e2e8f0">Generate code_verifier and code_challenge</text></g><g data-kind="message" data-id="2" data-from="app" data-to="browser" data-style="reply"><path class="sg-edge" d="M336,232 L70,232" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="203" y="223.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Redirect to /authorize with code_challenge</text></g><g data-kind="message" data-id="3" data-from="browser" data-to="auth" data-style="sync"><path class="sg-edge" d="M70,268 L637,268" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="353.5" y="259.87" text-anchor="middle" font-size="12" fill="#e2e8f0">GET /authorize</text></g><g data-kind="message" data-id="4" data-from="auth" data-to="browser" data-style="reply"><path class="sg-edge" d="M637,304 L70,304" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="353.5" y="295.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Login and consent, redirect with code</text></g><g data-kind="message" data-id="5" data-from="browser" data-to="app" data-style="async"><path class="sg-edge" d="M70,340 L336,340" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="203" y="331.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Callback with authorization code</text></g><g data-kind="message" data-id="6" data-from="app" data-to="auth" data-style="sync"><path class="sg-edge" d="M336,376 L637,376" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="486.5" y="367.87" text-anchor="middle" font-size="12" fill="#e2e8f0">POST /token with code and code_verifier</text></g><g data-kind="message" data-id="7" data-from="auth" data-to="app" data-style="reply"><path class="sg-edge" d="M637,412 L336,412" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="486.5" y="403.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Access token and refresh token</text></g><g data-kind="message" data-id="8" data-from="app" data-to="api" data-style="sync"><path class="sg-edge" d="M336,448 L808.5,448" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="572.25" y="439.87" text-anchor="middle" font-size="12" fill="#e2e8f0">GET /resource with bearer token</text></g><g data-kind="message" data-id="9" data-from="api" data-to="app" data-style="reply"><path class="sg-edge" d="M808.5,484 L336,484" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="572.25" y="475.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Protected resource</text></g>
</svg>
"
`;
