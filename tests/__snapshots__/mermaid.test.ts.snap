exports[`examples architecture matches its snapshot 1`] = `
{
  "text": 
"---
title: "Settings page flow"
---
flowchart TD
  subgraph frontend ["Frontend"]
    GeneralSettings("GeneralSettings")
    ThemeSelector("ThemeSelector")
    useSettings("useSettings")
  end
  subgraph backend ["Backend"]
    PatchSettings("PATCH /api/settings")
    SettingsController("settings.controller")
    SettingsService("SettingsService")
  end
  subgraph storage ["Storage"]
    SettingsRepository("SettingsRepository")
    SettingsTable("settings table")
  end
  GeneralSettings -->|"renders"| ThemeSelector
  GeneralSettings -->|"uses"| useSettings
  useSettings -->|"calls"| PatchSettings
  PatchSettings -->|"handles"| SettingsController
  SettingsController -->|"delegates"| SettingsService
  SettingsService -->|"uses"| SettingsRepository
  SettingsRepository -->|"reads/writes"| SettingsTable
"
,
  "warnings": [
    "type dropped",
  ],
}
`;

