{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?:\\{|\\bdo)\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:\\}|end\\b)"
  },
  "folding": {
    "markers": {
      "start": "(?:\\{|\\bdo)\\s*(?:#.*)?$",
      "end": "^\\s*(?:\\}|end)\\s*(?:#.*)?$"
    }
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*(?:[./-][\\p{L}\\p{N}_]+)*"
}
