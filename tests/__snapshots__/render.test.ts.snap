" y="636.87" text-anchor="start" font-size="12" fill="#6b7280">int</text></g></g><g data-kind="entity" data-id="product" data-type="catalog"><clipPath id="sg-clip-3"><rect x="20" y="296" width="168" height="102" rx="4"/></clipPath><rect class="sg-node" x="20" y="296" width="168" height="102" rx="4" fill="#fce7f3" stroke="#db2777" stroke-width="1.5"/><rect class="sg-header" x="20" y="296" width="168" height="54" fill="#e2e8f0" clip-path="url(#sg-clip-3)"/><text class="sg-text sg-label" x="104" y="321.22" text-anchor="middle" font-size="14" font-weight="600" fill="#831843">Product</text><text class="sg-muted sg-caption" x="104" y="335.75" text-anchor="middle" font-size="11" fill="#6b7280">catalog</text><g class="sg-attr" data-attr="id" data-keys="pk"><text class="sg-muted sg-attr-key" x="32" y="367.5" text-anchor="start" font-size="11" fill="#6b7280">PK</text><text class="sg-text" x="54.42" y="367.87" text-anchor="start" font-size="12" fill="#1f2430">id</text><text class="sg-muted sg-attr-type" x="99.04" y="367.87" text-anchor="start" font-size="12" fill="#6b7280">uuid</text></g><g class="sg-attr" data-attr="price"><text class="sg-text" x="54.42" y="388.87" text-anchor="start" font-size="12" fill="#1f2430">price</text><text class="sg-muted sg-attr-type" x="99.04" y="388.87" text-anchor="start" font-size="12" fill="#6b7280">decimal(10,2)</text></g></g>
</svg>
