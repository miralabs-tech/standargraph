exports[`examples order-state matches its snapshot 1`] = `
{
  "text": 
"---
title: "Order lifecycle"
---
stateDiagram-v2
  direction LR
  state "Pending" as pending
  pending : entry / reserve stock
  state "Paid" as paid
  state "Cancelled" as cancelled
  state "Fulfilment" as fulfilment
  state fulfilment {
    state "Picking" as picking
    state "Shipped" as shipped
    [*] --> picking
    picking --> shipped : handed to carrier / notify customer
  }
  state check <<choice>>
  [*] --> pending
  pending --> paid : payment received
  pending --> cancelled : timeout [after 30 min]
  paid --> fulfilment
  shipped --> check : delivery report
  check --> [*] : [delivered]
  check --> cancelled : [lost]
  cancelled --> [*]
"
,
  "warnings": [
    "metadata dropped",
  ],
}
`;

exports[`examples protocol matches its snapshot 1`] = `
{
  "text": 
"---
title: "OAuth 2.0 authorization code flow with PKCE"
---
sequenceDiagram
  participant browser as Browser
  participant app as App
  participant auth as Authorization server
  participant api as API
  browser->>app: Click sign in
  app->>app: Generate code_verifier and code_challenge
  app-->>browser: Redirect to /authorize with code_challenge
  browser->>auth: GET /authorize
  auth-->>browser: Login and consent, redirect with code
  browser-)app: Callback with authorization code
  app->>auth: POST /token with code and code_verifier
  auth-->>app: Access token and refresh token
  app->>api: GET /resource with bearer token
  api-->>app: Protected resource
"
,
  "warnings": [
    "type dropped",
  ],
}
`;

