celled" data-to="__final"><path class="sg-edge" d="M1600,99 L1610,99 L1610,130.67 L1660.71,130.67" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/></g><g data-kind="state" data-id="__initial" data-pseudo="initial"><circle class="sg-pseudo" cx="30" cy="102.67" r="10" fill="#1f2430"/></g><g data-kind="state" data-id="pending"><rect class="sg-node" x="100" y="68.67" width="132" height="68" rx="10" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="166" y="93.76" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Pending</text><line class="sg-divider" x1="100" y1="108.67" x2="232" y2="108.67" stroke="#475569" stroke-width="1"/><text class="sg-muted sg-caption" x="112" y="125.55" text-anchor="start" font-size="11" fill="#6b7280">entry / reserve stock</text></g><g data-kind="state" data-id="paid"><rect class="sg-node" x="463" y="94" width="80" height="40" rx="10" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="503" y="119.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Paid</text></g><g data-kind="state" data-id="cancelled" data-confidence="confirmed"><title>Source: src/orders/machine.ts (confirmed)</title><rect class="sg-node" x="1508" y="79" width="92" height="40" rx="10" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="1554" y="104.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Cancelled</text></g><g data-kind="state" data-id="fulfilment__initial" data-pseudo="initial"><circle class="sg-pseudo" cx="625" cy="134" r="10" fill="#1f2430"/></g><g data-kind="state" data-id="picking"><rect class="sg-node" x="655" y="114" width="80" height="40" rx="10" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="695" y="139.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Picking</text></g><g d