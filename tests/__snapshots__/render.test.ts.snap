exports[`snapshots protocol in the light theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="sequence" version="1.1" viewBox="0 0 878.5 542" width="878.5" height="542" font-family="Inter, system-ui, sans-serif">
<title>OAuth 2.0 authorization code flow with PKCE</title>
<defs><style>.sg-root{--sg-bg:#ffffff;--sg-fg:#1f2430;--sg-muted:#6b7280;--sg-node-fill:#ffffff;--sg-node-stroke:#475569;--sg-unknown-fill:#f1f5f9;--sg-group-fill:#f1f5f9;--sg-group-stroke:#cbd5e1;--sg-edge:#475569;--sg-label-bg:#ffffff;--sg-accent:#2563eb;--sg-lifeline:#94a3b8;--sg-header-fill:#e2e8f0}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}</style><marker id="sg-arrow-filled" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-filled" d="M0,0 L10,5 L0,10 z" fill="#475569" stroke="#475569" stroke-width="1" stroke-linejoin="round"/></marker><marker id="sg-arrow-open" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-open" d="M1,1 L9,5 L1,9" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<rect class="sg-bg" x="0" y="0" width="878.5" height="542" fill="#ffffff"/>
<g data-kind="participant" data-id="browser" data-type="client"><line class="sg-lifeline" x1="70" y1="74" x2="70" y2="522" stroke="#94a3b8" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="20" y="20" width="100" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="70" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Browser</text><text class="sg-muted sg-caption" x="70" y="59.75" text-anchor="middle" font-size="11" fill="#6b7280">client</text></g><g data-kind="participant" data-id="app" data-type="client"><line class="sg-lifeline" x1="336" y1="74" x2="336" y2="522" stroke="#94a3b8" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="286" y="20" width="100" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="336" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">App</text><text class="sg-muted sg-caption" x="336" y="59.75" text-anchor="middle" font-size="11" fill="#6b7280">client</text></g><g data-kind="participant" data-id="auth" data-type="service"><line class="sg-lifeline" x1="637" y1="74" x2="637" y2="522" stroke="#94a3b8" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="555.5" y="20" width="163" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="637" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Authorization server</text><text class="sg-muted sg-caption" x="637" y="59.75" text-anchor="middle" font-size="11" fill="#6b7280">service</text></g><g data-kind="participant" data-id="api" data-type="service"><line class="sg-lifeline" x1="808.5" y1="74" x2="808.5" y2="522" stroke="#94a3b8" stroke-width="1" stroke-dasharray="4 4"/><rect class="sg-node" x="758.5" y="20" width="100" height="54" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="808.5" y="45.22" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">API</text><text class="sg-muted sg-caption" x="808.5" y="59.75" text-anchor="middle" font-size="11" fill="#6b7280">service</text></g><g data-kind="message" data-id="0" data-from="browser" data-to="app" data-style="sync"><path class="sg-edge" d="M70,142 L336,142" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="203" y="133.87" text-anchor="middle" font-size="12" fill="#1f2430">Click sign in</text></g><g data-kind="message" data-id="1" data-from="app" data-to="app" data-style="sync"><path class="sg-edge" d="M336,160 H366 V180 H336" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="499.5" y="174.37" text-anchor="middle" font-size="12" fill="#1f2430">Generate code_verifier and code_challenge</text></g><g data-kind="message" data-id="2" data-from="app" data-to="browser" data-style="reply"><path class="sg-edge" d="M336,232 L70,232" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="203" y="223.87" text-anchor="middle" font-size="12" fill="#1f2430">Redirect to /authorize with code_challenge</text></g><g data-kind="message" data-id="3" data-from="browser" data-to="auth" data-style="sync"><path class="sg-edge" d="M70,268 L637,268" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="353.5" y="259.87" text-anchor="middle" font-size="12" fill="#1f2430">GET /authorize</text></g><g data-kind="message" data-id="4" data-from="auth" data-to="browser" data-style="reply"><path class="sg-edge" d="M637,304 L70,304" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="353.5" y="295.87" text-anchor="middle" font-size="12" fill="#1f2430">Login and consent, redirect with code</text></g><g data-kind="message" data-id="5" data-from="browser" data-to="app" data-style="async"><path class="sg-edge" d="M70,340 L336,340" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="203" y="331.87" text-anchor="middle" font-size="12" fill="#1f2430">Callback with authorization code</text></g><g data-kind="message" data-id="6" data-from="app" data-to="auth" data-style="sync"><path class="sg-edge" d="M336,376 L637,376" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="486.5" y="367.87" text-anchor="middle" font-size="12" fill="#1f2430">POST /token with code and code_verifier</text></g><g data-kind="message" data-id="7" data-from="auth" data-to="app" data-style="reply"><path class="sg-edge" d="M637,412 L336,412" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="486.5" y="403.87" text-anchor="middle" font-size="12" fill="#1f2430">Access token and refresh token</text></g><g data-kind="message" data-id="8" data-from="app" data-to="api" data-style="sync"><path class="sg-edge" d="M336,448 L808.5,448" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="572.25" y="439.87" text-anchor="middle" font-size="12" fill="#1f2430">GET /resource with bearer token</text></g><g data-kind="message" data-id="9" data-from="api" data-to="app" data-style="reply"><path class="sg-edge" d="M808.5,484 L336,484" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="572.25" y="475.87" text-anchor="middle" font-size="12" fill="#1f2430">Protected resource</text></g>
</svg>
"
`;

exports[`snapshots agent-output in the light theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="graph" version="1.1" viewBox="0 0 287 866" width="287" height="866" font-family="Inter, system-ui, sans-serif">
<title>Files touched by the settings view</title>
<defs><style>.sg-root{--sg-bg:#ffffff;--sg-fg:#1f2430;--sg-muted:#6b7280;--sg-node-fill:#ffffff;--sg-node-stroke:#475569;--sg-unknown-fill:#f1f5f9;--sg-group-fill:#f1f5f9;--sg-group-stroke:#cbd5e1;--sg-edge:#475569;--sg-label-bg:#ffffff;--sg-accent:#2563eb;--sg-lifeline:#94a3b8;--sg-header-fill:#e2e8f0}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}</style><marker id="sg-arrow-filled" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-filled" d="M0,0 L10,5 L0,10 z" fill="#475569" stroke="#475569" stroke-width="1" stroke-linejoin="round"/></marker><marker id="sg-arrow-open" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-open" d="M1,1 L9,5 L1,9" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<rect class="sg-bg" x="0" y="0" width="287" height="866" fill="#ffffff"/>
