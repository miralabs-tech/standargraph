array="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="353.5" y="295.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Login and consent, redirect with code</text></g><g data-kind="message" data-id="5" data-from="browser" data-to="app" data-style="async"><path class="sg-edge" d="M70,340 L336,340" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="203" y="331.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Callback with authorization code</text></g><g data-kind="message" data-id="6" data-from="app" data-to="auth" data-style="sync"><path class="sg-edge" d="M336,376 L637,376" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="486.5" y="367.87" text-anchor="middle" font-size="12" fill="#e2e8f0">POST /token with code and code_verifier</text></g><g data-kind="message" data-id="7" data-from="auth" data-to="app" data-style="reply"><path class="sg-edge" d="M637,412 L336,412" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3" marker-end="url(#sg-arrow-open)"/><text class="sg-text sg-edge-label" x="486.5" y="403.87" text-anchor="middle" font-size="12" fill="#e2e8f0">Access token and refresh token</text></g><g data-kind="message" data-id="8" data-from="app" data-to="api" data-style="sync"><path class="sg-edge" d="M336,448 L808.5,448" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" marker-end="url(#sg-arrow-filled)"/><text class="sg-text sg-edge-label" x="572.25" y="439.87" text-anchor="middle" font-size="12" fill="#e2e8f0">GET /resource with bearer token</text></g><g data-kind="message" data-id="9" data-from="api" data-to="app" data-style="reply"><path class="sg-edge" d="M808.5,484 L336,484" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linejoin="round" stroke-dasharray="5 3