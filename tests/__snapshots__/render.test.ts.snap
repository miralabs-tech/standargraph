troke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="755.5" y="149.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">state, er, tree</text></g><g data-kind="node" data-id="render" data-shape="box" data-depth="1" data-side="right"><rect class="sg-node" x="564" y="202" width="94" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="611" y="227.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Rendering</text></g><g data-kind="node" data-id="svg" data-shape="box" data-depth="2" data-side="right"><rect class="sg-node" x="715.5" y="176" width="80" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="755.5" y="201.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">SVG</text></g><g data-kind="node" data-id="webgl" data-shape="box" data-depth="2" data-side="right"><title>Sigma.js above 2000 nodes</title><rect class="sg-node" x="715.5" y="228" width="80" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="755.5" y="253.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">WebGL</text></g><g data-kind="node" data-id="text-syntax-j8" data-shape="box" data-depth="1" data-side="left"><rect class="sg-node" x="192" y="111" width="135" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="259.5" y="136.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Text syntax [J8]</text></g><g data-kind="node" data-id="github" data-shape="box" data-depth="1" data-side="left"><rect class="sg-node" x="219.5" y="163" width="80" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="259.5" y="188.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">GitHub</text></g><g data-kind="node" data-id="mermaid-export" data-shape="box" data-depth="2" data-side="left"><rect class="sg-node" x="20" y="137" width="132" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="86" y="162.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Mermaid export</text></g><g data-kind="node" data-id="pages-demo" data-shape="box" data-depth="2" data-side="left"><rect class="sg-node" x="32" y="189" width="108" height="40" rx="8" fill="#ffffff" stroke="#475569" stroke-width="1.5"/><text class="sg-text sg-label" x="86" y="214.09" text-anchor="middle" font-size="14" font-weight="600" fill="#1f2430">Pages demo</text></g>
