exports[`snapshots roadmap-mindmap in the light theme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" class="sg-root" data-diagram="tree" data-layout="mindmap" version="1.1" viewBox="0 0 833 288" width="833" height="288" font-family="Inter, system-ui, sans-serif">
<title>StandarGraph v1</title>
<defs><style>.sg-root{--sg-bg:#ffffff;--sg-fg:#1f2430;--sg-muted:#6b7280;--sg-node-fill:#ffffff;--sg-node-stroke:#475569;--sg-unknown-fill:#f1f5f9;--sg-group-fill:#f1f5f9;--sg-group-stroke:#cbd5e1;--sg-edge:#475569;--sg-label-bg:#ffffff;--sg-accent:#2563eb;--sg-lifeline:#94a3b8;--sg-header-fill:#e2e8f0}.sg-bg{fill:var(--sg-bg)}.sg-text{fill:var(--sg-fg)}.sg-muted{fill:var(--sg-muted)}.sg-node{fill:var(--sg-node-fill);stroke:var(--sg-node-stroke)}.sg-node.sg-unknown{fill:var(--sg-unknown-fill)}.sg-node-detail{fill:none;stroke:var(--sg-node-stroke)}.sg-divider{stroke:var(--sg-node-stroke)}.sg-header{fill:var(--sg-header-fill)}.sg-pseudo{fill:var(--sg-fg)}.sg-group{fill:var(--sg-group-fill);stroke:var(--sg-group-stroke)}.sg-edge{stroke:var(--sg-edge)}.sg-arrow-filled{fill:var(--sg-edge);stroke:var(--sg-edge)}.sg-arrow-open{stroke:var(--sg-edge)}.sg-label-bg{fill:var(--sg-label-bg)}.sg-accent{fill:var(--sg-accent)}.sg-lifeline{stroke:var(--sg-lifeline)}</style><marker id="sg-arrow-filled" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-filled" d="M0,0 L10,5 L0,10 z" fill="#475569" stroke="#475569" stroke-width="1" stroke-linejoin="round"/></marker><marker id="sg-arrow-open" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="10" orient="auto"><path class="sg-arrow-open" d="M1,1 L9,5 L1,9" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<rect class="sg-bg" x="0" y="0" width="833" height="288" fill="#ffffff"/>
<g data-kind="edge" data-id="format" data-from="standargraph-v1" data-to="format"><path class="sg-edge" d="M524,157 C547.5,157 547.5,92 571,92" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="graph" data-from="format" data-to="graph"><path class="sg-edge" d="M651,92 C683.25,92 683.25,40 715.5,40" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="sequence" data-from="format" data-to="sequence"><path class="sg-edge" d="M651,92 C680.5,92 680.5,92 710,92" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="state-er-tree" data-from="format" data-to="state-er-tree"><path class="sg-edge" d="M651,92 C674.5,92 674.5,144 698,144" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="render" data-from="standargraph-v1" data-to="render"><path class="sg-edge" d="M524,157 C544,157 544,222 564,222" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="svg" data-from="render" data-to="svg"><path class="sg-edge" d="M658,222 C686.75,222 686.75,196 715.5,196" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="webgl" data-from="render" data-to="webgl"><path class="sg-edge" d="M658,222 C686.75,222 686.75,248 715.5,248" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="text-syntax-j8" data-from="standargraph-v1" data-to="text-syntax-j8"><path class="sg-edge" d="M367,157 C347,157 347,131 327,131" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge" data-id="github" data-from="standargraph-v1" data-to="github"><path class="sg-edge" d="M367,157 C333.25,157 333.25,183 299.5,183" fill="none" stroke="#475569" stroke-width="1.5" stroke-linejoin="round"/></g><g data-kind="edge